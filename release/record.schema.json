{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pickla Release V1 record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "candidate_sha", "base_sha", "policy_sha", "tree_sha", "domains", "capabilities", "risk_floor", "urgency", "invariants", "stage", "edge_manifest", "intended_production", "recovery_reference", "evidence", "status", "blockers", "events", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "pattern": "^rel-[0-9a-f]{12}-[0-9a-f]{8}$" },
    "candidate_sha": { "$ref": "#/$defs/sha" },
    "base_sha": { "$ref": "#/$defs/sha" },
    "policy_sha": { "$ref": "#/$defs/hash" },
    "tree_sha": { "$ref": "#/$defs/sha" },
    "domains": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "risk_floor": { "enum": ["HOTFIX", "STANDARD", "HIGH", "CRITICAL"] },
    "urgency": { "enum": ["normal", "urgent"] },
    "decision": { "enum": ["CLASSIFIED", "NEEDS_REVIEW"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "affected_edge_functions": { "type": "array", "items": { "type": "string" } },
    "edge_manifest": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
    "invariants": { "type": "object", "additionalProperties": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["required", "passed", "failed", "blocked"] } } } },
    "stage": { "type": ["object", "null"] },
    "intended_production": { "type": "object" },
    "recovery_reference": { "type": ["string", "null"] },
    "evidence": { "type": "object" },
    "status": { "enum": ["INSPECTED", "BLOCKED", "READY_FOR_APPROVAL"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "events": { "type": "array", "items": { "type": "object", "required": ["event", "at"] } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
